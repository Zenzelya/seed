# ════════════════════════════════════════════════════════════════════
#  Шаблон окружения (в гите). setup.sh генерирует .env из этого файла.
#  Вручную: cp .env.example .env  и отредактируй под проект.
#
#  Что генерируется автоматически:
#    COMPOSE_PROJECT_NAME — имя папки проекта
#    COMPOSE_SERVICES     — выбор сервисов из меню setup.sh
#    Порты                — по формуле BASE+SLOT, уникальные на машине
#    POSTGRES_DB          — совпадает с именем проекта
# ════════════════════════════════════════════════════════════════════

# ── Project ───────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=app
COMPOSE_SERVICES=0+1+4+5

# ── Ports (BASE + SLOT) ───────────────────────────────────────────
# Слот 0 = дефолтные порты. setup.sh / doc выбирают слот автоматически.
DB_PORT=5432
REDIS_PORT=6379
API_PORT=3000
API_DEBUG_PORT=9230
FRONT_PORT=4200
PARSER_PORT=8000

# ── Container user ────────────────────────────────────────────────
# Узнать свой: id -u && id -g
UID=1000
GID=1000

# ── Postgres ──────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=app
