# Шаблон backend/.env — генерируется setup.sh через envsubst.
# ${API_PORT} и ${FRONT_PORT} подставляются из вычисленного слота.
# Внутренние порты Docker-сети (POSTGRES_PORT, REDIS_PORT) — всегда фиксированы.

# App
PORT=3000
API_URL=http://localhost:${API_PORT}
FRONT_URL=http://localhost:${FRONT_PORT}
CORS_ORIGIN=http://localhost:${FRONT_PORT}
CORS_CRED=true
DEFAULT_PRODUCT_IMAGE=/public/defaults/product-placeholder.webp

# App pipes settings
VALIDATION_WHITELIST=true
VALIDATION_FORBID_NON_WHITELISTED=true
VALIDATION_TRANSFORM=true

# PostgreSQL (внутренние — не менять)
POSTGRES_TYPE=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=app
POSTGRES_SYNC=true

# JWT
JWT_ACCESS_SECRET=change_me_min_32_chars_long_random_string
JWT_REFRESH_SECRET=change_me_min_32_chars_long_random_string
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# Redis (внутренние — не менять)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Google Auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:${API_PORT}/auth/google/callback

# Pagination
PAGINATION_LIMIT=16
PAGINATION_OFFSET=0

# Parser (внутренняя сеть — не менять)
PARSER_URL=http://fast:8000

# Data file paths (mounted at /data)
DATA_DE_DUMP_PATH=/data/de-extract.jsonl.gz
DATA_DE_FREQ_PATH=/data/deu_wikipedia_2021_1M/deu_wikipedia_2021_1M-words.txt
DATA_DE_SEED_DIR=/data/seed/de
DATA_EN_DUMP_PATH=/data/raw-wiktextract-data.jsonl.gz
DATA_EN_FREQ_PATH=/data/eng_wikipedia_2016_1M/eng_wikipedia_2016_1M-words.txt
